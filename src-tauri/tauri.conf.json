{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markseal",
  "version": "0.2.0",
  "identifier": "in.d3ltasecurity.markseal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Markseal",
        "width": 1280,
        "height": 820,
        "transparent": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-component-update --no-proxy-server"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "D3lta Security",
    "copyright": "Copyright (c) 2026 D3lta Security",
    "category": "Productivity",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://d3ltasecurity.in",
    "shortDescription": "Offline Markdown editor with per-note encryption",
    "longDescription": "Markseal is a local-first, offline Markdown editor. Notes and their images can be encrypted one by one with AES-256-GCM and Argon2id. No account and no cloud; Markseal itself sends nothing anywhere.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}